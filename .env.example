# ═══════════════════════════════════════════════════════════════════════════════════════
# ArXiv Research Assistant — Environment Configuration (Mode B: Standalone)
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Set GROQ_API_KEY with your actual key (REQUIRED for generation)
# 3. Adjust other values as needed for your environment
# 4. NEVER commit .env — it contains secrets and is gitignored
#
# USAGE:
# - This file is for Mode B (standalone development)
# - For Docker Mode A (workspace root), use root .env instead
# - All services run on localhost with standard ports
#
# ═══════════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 1: DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=arxiv
DB_PASSWORD=arxiv_secret
DB_NAME=arxiv_db

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 2: SERVICE URLs (Localhost)
# ─────────────────────────────────────────────────────────────────────────────────────
# These URLs are for standalone development (services on localhost)
ML_SERVICE_URL=http://localhost:8001
QDRANT_URL=http://localhost:6333
OLLAMA_HOST=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 3: LLM PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# Provider selection: "groq" (cloud, fast) | "ollama" (local, RAM-heavy)
LLM_PROVIDER=groq

# Groq configuration (cloud provider)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_actual_key_here

# Ollama configuration (local provider - optional)
# OLLAMA_MODEL=phi3:mini
# OLLAMA_KEEP_ALIVE=0
# ═══════════════════════════════════════════════════════════════════════════════════════