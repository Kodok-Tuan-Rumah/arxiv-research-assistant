# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=arxiv
DB_PASSWORD=arxiv_secret
DB_NAME=arxiv_db

# ML Service
ML_SERVICE_URL=http://localhost:8001

# LLM Provider — "ollama" (local) or "groq" (cloud)
LLM_PROVIDER=ollama

# Groq (required if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_your_actual_key_here
GROQ_MODEL=openai/gpt-oss-20b
